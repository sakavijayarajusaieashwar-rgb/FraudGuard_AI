# FraudGuard AI Environment Variables
# Copy this file to .env and set your API keys

# Gemini API Key (Option 1)
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI API Key (Option 2)
OPENAI_API_KEY=your_openai_api_key_here

# Default Provider: "gemini", "openai", or "heuristic"
LLM_PROVIDER=gemini

JWT_SECRET_KEY=replace_this_with_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
